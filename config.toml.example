# SpindleBot configuration
# Copy to ~/.config/spindlebot/config.toml and edit for your machine.
# Run: python3 -m spindlebot check

[core]
# Import: active import area — XLD rips / downloads land here for processing.
# Processing: in-flight import work happens here; an album promotes to Pending
#   only once every track has a terminal .lrc/.nolrc marker (lyric-complete), so
#   a mount-sync can never prune audio mid-fetch or strand late lyric sidecars.
# Pending: processed, lyric-complete albums waiting to be distributed to
#   retention destinations. Complete-by-construction — sync/prune trust it.
# (legacy keys staging_dir/library_dir are still honored if present.)
import_dir     = "~/Library/Application Support/SpindleBot/Import"
processing_dir = "~/Library/Application Support/SpindleBot/Processing"
pending_dir    = "~/Library/Application Support/SpindleBot/Pending"
log_dir     = "~/.config/beets"    # watcher.log and music-sync.log land here
archive_dir = "~/Library/Application Support/SpindleBot/Archive"  # XLD .log files archived here after import
duplicates_dir = "~/Library/Application Support/SpindleBot/Duplicates"  # rips already in the library are moved here (never stranded in Import)
# After a successful import, automatically run the content-addressed mount-sync
# to push new albums to the retention drive. Default false: imports finish faster and just
# log a hint to sync manually. true trades slower imports for hands-off syncing
# (only fires when the retention drive is mounted; the sync self-guards otherwise).
# Env override: SPINDLEBOT_AUTO_SYNC_ON_IMPORT
auto_sync_on_import = false

[tools]
beet         = "/opt/homebrew/bin/beet"
python       = "/opt/homebrew/bin/python3"
beets_config = "~/.config/beets/config.yaml"
beets_db     = "~/.config/beets/library.db"
mpv          = "/opt/homebrew/bin/mpv"  # used by lrc-editor preview

[notifications]
macos_notify     = true
telegram_enabled = true   # set to false to disable Telegram without removing secrets

[lyrics]
sources               = ["lrclib"]   # future: add "shazam"
request_delay_seconds = 0.3          # politeness delay between lrclib API calls

[art]
sources     = ["caa", "itunes"]   # Cover Art Archive, then iTunes Store fallback
min_size_px = 500

# -- Sync destinations ---------------------------------------------------------
# Add as many [[destinations]] blocks as you like.
# The first enabled local_drive destination is the retention target used by music-sync.sh.
# type = "local_drive"  -> rsync to a mounted volume
# type = "rclone"       -> rclone to any configured remote (B2, S3, SFTP, etc.)

[[destinations]]
name    = "MyDrive"
type    = "local_drive"
path    = "/Volumes/MyDrive/Music/Library"
enabled = true

# [[destinations]]
# name    = "Backblaze"
# type    = "rclone"
# path    = "b2:my-music-bucket/Library"
# enabled = false
