<script>
const statusEl = document.getElementById("status");
const libraryEl = document.getElementById("library");
const outputEl  = document.getElementById("output");
const btnRun    = document.getElementById("btn-run");
const summaryEl = document.getElementById("summary");
const table     = document.getElementById("results");
const tbody     = table.querySelector("tbody");

function setStatus(msg, ok=true) {
  statusEl.textContent = msg;
  statusEl.className = ok ? "" : "err";
}

document.getElementById("btn-back").addEventListener("click", () => location.href = "/");

async function pick(endpoint, input) {
  const j = await (await fetch(endpoint, { method: "POST" })).json();
  if (j.ok) input.value = j.path;
}
document.getElementById("pick-library").addEventListener("click",
  () => pick("/audit/pick-folder", libraryEl));
document.getElementById("pick-output").addEventListener("click",
  () => pick("/audit/pick-output", outputEl));

function render(results) {
  const suspicious = results.filter(r => r.suspicious);
  summaryEl.textContent =
    `${suspicious.length} of ${results.length} files look mistimed`;
  tbody.innerHTML = "";
  const prefix = libraryEl.value.replace(/\/?$/, "/");
  for (const r of suspicious) {
    const tr = document.createElement("tr");
    const shown = r.path.startsWith(prefix) ? r.path.slice(prefix.length) : r.path;

    const pathTd = document.createElement("td");
    pathTd.className = "path";
    pathTd.textContent = shown;

    const reasonsTd = document.createElement("td");
    reasonsTd.className = "reasons";
    reasonsTd.textContent = r.reasons.join(", ");

    const linesTd = document.createElement("td");
    linesTd.textContent = r.stats && r.stats.line_count != null ? r.stats.line_count : "";

    const editTd = document.createElement("td");
    editTd.className = "edit";
    const btn = document.createElement("button");
    btn.textContent = "Edit";
    btn.addEventListener("click", async () => {
      const j = await (await fetch("/load", {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify({ lrc: r.path }),
      })).json();
      if (!j.ok) { setStatus(j.error, false); return; }
      location.href = "/";
    });
    editTd.appendChild(btn);

    tr.append(pathTd, reasonsTd, linesTd, editTd);
    tbody.appendChild(tr);
  }
  table.style.display = suspicious.length ? "table" : "none";
}

btnRun.addEventListener("click", async () => {
  if (!libraryEl.value.trim() || !outputEl.value.trim()) {
    setStatus("Pick a folder to audit and an output file first", false);
    return;
  }
  btnRun.disabled = true;
  setStatus("Auditing…");
  const j = await (await fetch("/audit/run", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({ library: libraryEl.value.trim(),
                           output: outputEl.value.trim() }),
  })).json();
  if (!j.ok) { btnRun.disabled = false; setStatus(j.error, false); return; }
  const poll = setInterval(async () => {
    let s;
    try { s = await (await fetch("/audit/status")).json(); }
    catch (e) { return; }
    if (s.running) return;
    clearInterval(poll);
    btnRun.disabled = false;
    if (s.error || !s.result) { setStatus("Audit failed: " + (s.error || "no result"), false); return; }
    setStatus("Audit complete ✓");
    render(s.result);
  }, 1000);
});

(async () => {
  const saved = await (await fetch("/audit/saved")).json();
  if (saved.library) libraryEl.value = saved.library;
  if (saved.json_path) outputEl.value = saved.json_path;
  if (saved.results) {
    render(saved.results);
    setStatus("Loaded saved audit ✓");
  }
})();
</script>
</body>
</html>
"""

