<script>
// ────────────────────────────────────────────────────────────────────────────
// State
// ────────────────────────────────────────────────────────────────────────────
let lyrics = [];       // [{time, text}, ...]
let undoStack = [];    // array of deep-copied lyrics snapshots
let ws = null;
let duration = 0;
let activeIdx = -1;
let selectedMarkerIdx = -1;

const btnUndo   = document.getElementById("btn-undo");
const btnDelete = document.getElementById("btn-delete");

function pushUndo() {
  undoStack.push(JSON.parse(JSON.stringify(lyrics)));
  btnUndo.disabled = false;
}

function undo() {
  if (!undoStack.length) return;
  lyrics = undoStack.pop();
  btnUndo.disabled = undoStack.length === 0;
  selectedMarkerIdx = Math.min(selectedMarkerIdx, lyrics.length - 1);
  sortAndRender();
  updateDeleteBtn();
  setStatus("Undone ✓");
}
btnUndo.addEventListener("click", undo);

function updateDeleteBtn() {
  btnDelete.disabled = selectedMarkerIdx < 0 || selectedMarkerIdx >= lyrics.length;
}

// ── Help modal ───────────────────────────────────────────────────────────────
const helpModal = document.getElementById("help-modal");
document.getElementById("btn-help").addEventListener("click",  () => helpModal.classList.toggle("open"));
document.getElementById("help-close").addEventListener("click", () => helpModal.classList.remove("open"));
helpModal.addEventListener("click", (e) => { if (e.target === helpModal) helpModal.classList.remove("open"); });

// ── Non-blocking confirm modal ────────────────────────────────────────────────
// Replaces window.confirm() so the audio context isn't suspended.
const confirmModal  = document.getElementById("confirm-modal");
const confirmMsg    = document.getElementById("confirm-message");
const confirmOkBtn  = document.getElementById("confirm-ok");
const confirmCancel = document.getElementById("confirm-cancel");
let _confirmResolve = null;

function showConfirm(message, okLabel = "Delete") {
  return new Promise((resolve) => {
    confirmMsg.textContent = message;
    confirmOkBtn.textContent = okLabel;
    _confirmResolve = resolve;
    confirmModal.classList.add("open");
    confirmCancel.focus(); // default focus on Cancel — safer
  });
}

confirmOkBtn.addEventListener("click", () => {
  confirmModal.classList.remove("open");
  if (_confirmResolve) { _confirmResolve(true);  _confirmResolve = null; }
});
confirmCancel.addEventListener("click", () => {
  confirmModal.classList.remove("open");
  if (_confirmResolve) { _confirmResolve(false); _confirmResolve = null; }
});
confirmModal.addEventListener("click", (e) => {
  if (e.target === confirmModal) {
    confirmModal.classList.remove("open");
    if (_confirmResolve) { _confirmResolve(false); _confirmResolve = null; }
  }
});

// ── Keyboard shortcuts ────────────────────────────────────────────────────
document.addEventListener("keydown", (e) => {
  // Don't intercept when user is typing in an input/textarea
  if (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA") return;

  // Confirm modal takes full keyboard priority
  if (confirmModal.classList.contains("open")) {
    if (e.key === "Enter" || e.key === "y") {
      e.preventDefault();
      confirmOkBtn.click();
    } else if (e.key === "Escape" || e.key === "n") {
      e.preventDefault();
      confirmCancel.click();
    }
    return; // swallow everything else while modal is open
  }

  // Help modal takes keyboard priority (after confirm)
  if (helpModal.classList.contains("open")) {
    if (e.key === "Escape" || e.key === "?" || e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      helpModal.classList.remove("open");
    }
    return; // swallow everything else while modal is open
  }

  const ctrl = e.ctrlKey || e.metaKey;

  if (ctrl && e.key === "z") { e.preventDefault(); undo(); return; }
  if (e.key === "?") { e.preventDefault(); helpModal.classList.add("open"); document.getElementById("help-close").focus(); return; }

  // Add line
  if (e.key === "a" && !ctrl) { e.preventDefault(); addLine(); return; }

  // Delete selected
  if ((e.key === "Delete" || e.key === "Backspace") && !ctrl) {
    e.preventDefault(); deleteSelected(); return;
  }

  // Edit selected text
  if ((e.key === "e" || e.key === "Enter") && !ctrl) {
    e.preventDefault();
    if (selectedMarkerIdx >= 0 && selectedMarkerIdx < lyrics.length) {
      editLineText(selectedMarkerIdx);
    }
    return;
  }

  if (!ws) return;

  if (e.key === " ") { e.preventDefault(); ws.playPause(); return; }
  if (e.key === "m") { e.preventDefault(); ws.setMuted(!ws.getMuted()); setStatus(ws.getMuted() ? "Muted 🔇" : "Unmuted 🔊"); return; }
  if (e.key === "Home") { e.preventDefault(); ws.seekTo(0); return; }

  if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
    e.preventDefault();
    const dir = e.key === "ArrowLeft" ? -1 : 1;
    const delta = e.shiftKey ? 0.1 : ctrl ? 5 : 1;
    const cur = ws.getCurrentTime();
    ws.seekTo(Math.max(0, Math.min(1, (cur + dir * delta) / duration)));
    return;
  }

  if (e.key === "[" || e.key === "]") {
    e.preventDefault();
    if (!lyrics.length) return;
    let idx;
    if (selectedMarkerIdx >= 0) {
      idx = selectedMarkerIdx + (e.key === "[" ? -1 : 1);
      idx = Math.max(0, Math.min(lyrics.length - 1, idx));
    } else {
      const cur = ws.getCurrentTime();
      if (e.key === "[") {
        idx = -1;
        for (let i = lyrics.length - 1; i >= 0; i--) {
          if (lyrics[i].time < cur - 0.05) { idx = i; break; }
        }
        if (idx < 0) idx = lyrics.length - 1;
      } else {
        idx = -1;
        for (let i = 0; i < lyrics.length; i++) {
          if (lyrics[i].time > cur + 0.05) { idx = i; break; }
        }
        if (idx < 0) idx = 0;
      }
    }
    selectMarker(idx, true);
    return;
  }

  if (e.key === "," || e.key === ".") {
    e.preventDefault();
    if (selectedMarkerIdx < 0 || selectedMarkerIdx >= lyrics.length) {
      setStatus("No marker selected — click one first", false); return;
    }
    const dir = e.key === "," ? -1 : 1;
    const delta = e.shiftKey ? 1.0 : 0.1;
    nudgeSelected(dir * delta);
    return;
  }
});

const markerLayer = document.getElementById("marker-layer");
const lyricsPanel = document.getElementById("lyrics-panel");
const timeDisplay = document.getElementById("time-display");
const statusEl    = document.getElementById("status");
const btnPlay     = document.getElementById("btn-playpause");

function setStatus(msg, ok=true) {
  statusEl.textContent = msg;
  statusEl.style.color = ok ? "#4caf50" : "#e94560";
  if (ok) setTimeout(() => { if (statusEl.textContent === msg) statusEl.textContent = ""; }, 3000);
}

// ────────────────────────────────────────────────────────────────────────────
// Format helpers
// ────────────────────────────────────────────────────────────────────────────
function fmtTime(t) {
  const m = Math.floor(t / 60);
  const s = (t - m*60).toFixed(2).padStart(5,"0");
  return `${m}:${s}`;
}

// ────────────────────────────────────────────────────────────────────────────
// Add / Delete / Edit line
// ────────────────────────────────────────────────────────────────────────────
function addLine() {
  const t = ws ? Math.round(ws.getCurrentTime() * 100) / 100 : 0;
  pushUndo();
  const newLn = { time: t, text: "" };
  lyrics.push(newLn);
  lyrics.sort((a, b) => a.time - b.time);
  renderMarkers();
  renderLyrics();
  const idx = lyrics.indexOf(newLn);
  selectedMarkerIdx = idx;
  updateMarkerClasses();
  updateSelectedRow();
  updateDeleteBtn();
  editLineText(idx);
  setStatus("New line — type text, Enter to confirm");
}

async function deleteSelected() {
  if (selectedMarkerIdx < 0 || selectedMarkerIdx >= lyrics.length) {
    setStatus("No line selected", false);
    return;
  }
  const ln = lyrics[selectedMarkerIdx];
  const preview = ln.text ? `"${ln.text.substring(0, 40)}"` : "(empty line)";
  const ok = await showConfirm(`Delete line at ${fmtTime(ln.time)}:\n${preview}`);
  if (!ok) return;
  pushUndo();
  lyrics.splice(selectedMarkerIdx, 1);
  selectedMarkerIdx = lyrics.length > 0 ? Math.min(selectedMarkerIdx, lyrics.length - 1) : -1;
  sortAndRender();
  updateDeleteBtn();
  setStatus("Line deleted ✓");
}

function editLineText(idx) {
  const rows = lyricsPanel.querySelectorAll(".lyric-row");
  const row = rows[idx];
  if (!row) return;

  // If already editing this row, bail
  if (row.querySelector(".lyric-text-input")) return;

  const textEl = row.querySelector(".lyric-text");
  if (!textEl) return;

  const original = lyrics[idx].text;
  let done = false;

  const input = document.createElement("input");
  input.type = "text";
  input.value = original;
  input.className = "lyric-text-input";

  textEl.replaceWith(input);
  input.focus();
  input.select();

  const finish = (save) => {
    if (done) return;
    done = true;

    const newText = save ? input.value : original;

    if (save && newText !== original) {
      pushUndo(); // snapshot BEFORE state (lyrics[idx].text still = original here)
    }

    lyrics[idx].text = newText;

    const span = document.createElement("span");
    span.className = "lyric-text";
    span.textContent = newText;
    attachTextDblClick(span, idx);
    input.replaceWith(span);

    if (save && newText !== original) {
      renderMarkers(); // update marker labels
      setStatus("Text updated ✓");
    }
  };

  input.addEventListener("keydown", (e) => {
    e.stopPropagation(); // prevent global shortcuts while typing
    if (e.key === "Enter")  { e.preventDefault(); finish(true); }
    if (e.key === "Escape") { e.preventDefault(); finish(false); }
  });

  input.addEventListener("blur", () => finish(true));
}

function attachTextDblClick(span, idx) {
  span.addEventListener("dblclick", (e) => {
    e.stopPropagation();
    selectMarker(idx, false);
    editLineText(idx);
  });
}

// ────────────────────────────────────────────────────────────────────────────
// WaveSurfer init
// ────────────────────────────────────────────────────────────────────────────
function initWaveSurfer() {
  ws = WaveSurfer.create({
    container: "#waveform",
    waveColor: "#4a6fa5",
    progressColor: "#e94560",
    height: 120,
    barWidth: 2,
    barGap: 1,
    barRadius: 2,
    url: "/audio",
    backend: "WebAudio",
    interact: true,
    hideScrollbar: true,
  });

  ws.on("ready", () => {
    duration = ws.getDuration();
    renderMarkers();
  });

  ws.on("audioprocess", onTimeUpdate);
  ws.on("seeking", onTimeUpdate);
  ws.on("finish", () => btnPlay.textContent = "▶");
  ws.on("play",   () => btnPlay.textContent = "⏸");
  ws.on("pause",  () => btnPlay.textContent = "▶");

  btnPlay.addEventListener("click", () => ws.playPause());
}

function onTimeUpdate() {
  const cur = ws.getCurrentTime();
  timeDisplay.textContent = `${fmtTime(cur)} / ${fmtTime(duration)}`;
  let idx = -1;
  for (let i = lyrics.length - 1; i >= 0; i--) {
    if (cur >= lyrics[i].time) { idx = i; break; }
  }
  if (idx !== activeIdx) {
    activeIdx = idx;
    highlightActive();
  }
  updateActiveMarker();
}

// ────────────────────────────────────────────────────────────────────────────
// Markers
// ────────────────────────────────────────────────────────────────────────────
function renderMarkers() {
  markerLayer.innerHTML = "";
  if (!duration) return;
  lyrics.forEach((ln, i) => {
    const pct = ln.time / duration * 100;
    const el = document.createElement("div");
    el.className = "marker";
    el.style.left = pct + "%";
    el.dataset.idx = i;
    el.title = `[${fmtTime(ln.time)}] ${ln.text}`;

    const label = document.createElement("div");
    label.className = "marker-label";
    label.textContent = ln.text;
    el.appendChild(label);

    el.addEventListener("click", (e) => {
      e.stopPropagation();
      selectMarker(i, true);
    });

    makeDraggable(el, i);
    markerLayer.appendChild(el);
  });
}

function makeDraggable(el, idx) {
  let startX, startPct;

  el.addEventListener("mousedown", (e) => {
    e.preventDefault();
    pushUndo();
    el.classList.add("dragging");
    startX = e.clientX;
    startPct = lyrics[idx].time / duration;

    const onMove = (e2) => {
      const rect2 = markerLayer.getBoundingClientRect();
      const dx = e2.clientX - startX;
      const newPct = Math.max(0, Math.min(1, startPct + dx / rect2.width));
      const newTime = newPct * duration;
      lyrics[idx].time = Math.round(newTime * 100) / 100;
      el.style.left = (newPct * 100) + "%";
      el.title = `[${fmtTime(lyrics[idx].time)}] ${lyrics[idx].text}`;
      const row = lyricsPanel.children[idx];
      if (row) row.querySelector(".lyric-time").textContent = fmtTime(lyrics[idx].time);
    };

    const onUp = () => {
      el.classList.remove("dragging");
      document.removeEventListener("mousemove", onMove);
      document.removeEventListener("mouseup", onUp);
      sortAndRender();
    };

    document.addEventListener("mousemove", onMove);
    document.addEventListener("mouseup", onUp);
  });
}

function sortAndRender() {
  lyrics.sort((a, b) => a.time - b.time);
  renderMarkers();
  renderLyrics();
}

function selectMarker(idx, seek=false) {
  selectedMarkerIdx = idx;
  if (seek && idx >= 0 && duration) ws.seekTo(lyrics[idx].time / duration);
  updateMarkerClasses();
  updateSelectedRow();
  updateDeleteBtn();
}

function nudgeSelected(delta) {
  if (selectedMarkerIdx < 0) return;
  pushUndo();
  const t = lyrics[selectedMarkerIdx].time + delta;
  lyrics[selectedMarkerIdx].time = Math.round(Math.max(0, Math.min(duration || 1e9, t)) * 100) / 100;
  const ref = lyrics[selectedMarkerIdx];
  sortAndRender();
  const reIdx = lyrics.indexOf(ref);
  selectedMarkerIdx = reIdx >= 0 ? reIdx : 0;
  updateMarkerClasses();
  updateSelectedRow();
  setStatus(`Nudged → ${fmtTime(lyrics[selectedMarkerIdx].time)}`);
}

function updateMarkerClasses() {
  const markers = markerLayer.querySelectorAll(".marker");
  markers.forEach((m, i) => {
    m.classList.toggle("active",   i === activeIdx);
    m.classList.toggle("selected", i === selectedMarkerIdx);
  });
}

function updateActiveMarker() { updateMarkerClasses(); }

function updateSelectedRow() {
  const rows = lyricsPanel.querySelectorAll(".lyric-row");
  rows.forEach((r, i) => r.classList.toggle("selected", i === selectedMarkerIdx));
  if (selectedMarkerIdx >= 0 && rows[selectedMarkerIdx]) {
    rows[selectedMarkerIdx].scrollIntoView({ block: "nearest", behavior: "smooth" });
  }
}

// ────────────────────────────────────────────────────────────────────────────
// Lyrics panel
// ────────────────────────────────────────────────────────────────────────────
function renderLyrics() {
  lyricsPanel.innerHTML = "";
  lyrics.forEach((ln, i) => {
    const row = document.createElement("div");
    row.className = "lyric-row";
    row.dataset.idx = i;

    const timeEl = document.createElement("span");
    timeEl.className = "lyric-time";
    timeEl.textContent = fmtTime(ln.time);

    const textEl = document.createElement("span");
    textEl.className = "lyric-text";
    textEl.textContent = ln.text || "";
    attachTextDblClick(textEl, i);

    // Per-row delete button (×), visible on hover
    const delBtn = document.createElement("button");
    delBtn.className = "lyric-del-btn";
    delBtn.textContent = "×";
    delBtn.title = "Delete line";
    delBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      selectMarker(i, false);
      deleteSelected();
    });

    row.appendChild(timeEl);
    row.appendChild(textEl);
    row.appendChild(delBtn);

    row.addEventListener("click", () => selectMarker(i, true));

    lyricsPanel.appendChild(row);
  });
}

function highlightActive() {
  const rows = lyricsPanel.querySelectorAll(".lyric-row");
  rows.forEach((r, i) => r.classList.toggle("active", i === activeIdx));
  if (activeIdx >= 0 && rows[activeIdx]) {
    rows[activeIdx].scrollIntoView({ block: "nearest", behavior: "smooth" });
  }
}

// ────────────────────────────────────────────────────────────────────────────
// Toolbar actions
// ────────────────────────────────────────────────────────────────────────────
document.getElementById("btn-add").addEventListener("click", addLine);
document.getElementById("btn-delete").addEventListener("click", deleteSelected);

