# ── Flask app ─────────────────────────────────────────────────────────────────
app = Flask(__name__)

@app.route("/")
def index():
    return HTML, 200, {"Content-Type": "text/html; charset=utf-8"}

@app.route("/meta")
def meta():
    return jsonify({
        "filename": FLAC_PATH.name,
        "lrc": str(LRC_PATH),
        "lrc_new": not LRC_PATH.exists(),
    })

@app.route("/audio")
def audio():
    return send_file(str(FLAC_PATH), mimetype="audio/flac", conditional=True)

@app.route("/lrc")
def lrc():
    # Serve from draft (already initialized on startup)
    return jsonify(parse_lrc(DRAFT_PATH))

@app.route("/save", methods=["POST"])
def save():
    data = request.get_json(force=True)
    DRAFT_PATH.write_text(format_lrc(data), encoding="utf-8")
    return jsonify({"ok": True})

@app.route("/commit", methods=["POST"])
def commit():
    if not DRAFT_PATH.exists():
        return jsonify({"ok": False, "error": "No draft found — save first"})
    shutil.copy2(DRAFT_PATH, LRC_PATH)
    return jsonify({"ok": True})

@app.route("/preview", methods=["POST"])
def preview():
    if not DRAFT_PATH.exists():
        return jsonify({"ok": False, "error": "No draft — save first"})
    if not os.path.exists(MPV_BIN):
        return jsonify({"ok": False, "error": f"mpv not found at {MPV_BIN}"})
    subprocess.Popen(
        [MPV_BIN, f"--sub-file={DRAFT_PATH}", str(FLAC_PATH)],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    )
    return jsonify({"ok": True})

# ── Main ──────────────────────────────────────────────────────────────────────
if __name__ == "__main__":
    # Initialize draft from existing LRC, or create an empty one
    lrc_new = not LRC_PATH.exists()
    if lrc_new:
        DRAFT_PATH.write_text("", encoding="utf-8")
        status_note = "  (no .lrc found — will be created on commit)"
    else:
        shutil.copy2(LRC_PATH, DRAFT_PATH)
        status_note = ""

    url = f"http://localhost:{PORT}"
    print(f"🎵  lrc-editor")
    print(f"    Audio : {FLAC_PATH}")
    print(f"    LRC   : {LRC_PATH}{status_note}")
    print(f"    URL   : {url}")
    print(f"    Ctrl+C to quit\n")

    def open_browser():
        import time; time.sleep(0.8)
        subprocess.Popen(["open", url])
    threading.Thread(target=open_browser, daemon=True).start()

    app.run(host="127.0.0.1", port=PORT, debug=False, use_reloader=False)
