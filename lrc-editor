@app.route("/load", methods=["POST"])
def load_track():
    """Load a track into the editor by its .lrc path (from the audit table)."""
    data = request.get_json(force=True)
    lrc_path = Path(data.get("lrc", "")).expanduser()
    # /commit later writes to state["lrc_path"] — never accept a path that
    # isn't an existing .lrc, and never write through a symlink (it would
    # redirect the commit to wherever the link points)
    if lrc_path.suffix != ".lrc" or not lrc_path.exists():
        return jsonify({"ok": False, "error": f"not an existing .lrc: {lrc_path}"})
    if lrc_path.is_symlink() or not lrc_path.is_file():
        return jsonify({"ok": False,
                        "error": f"refusing symlinked or non-regular .lrc: {lrc_path}"})
    lrc_path = lrc_path.resolve()
    audio = _sibling_audio(lrc_path)
    if audio is None:
        return jsonify({"ok": False,
                        "error": f"no audio file next to {lrc_path.name}"})
    state["flac_path"] = audio
    state["lrc_path"] = lrc_path
    _init_draft()
    print(f"\n    ↳ Audio : {audio}")
    print(f"      LRC   : {lrc_path}", flush=True)
    return jsonify({"ok": True})

