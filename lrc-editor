def preview():
    if not state["flac_path"]:
        return jsonify({"ok": False, "error": "No file loaded"})
    if not DRAFT_PATH.exists():
        return jsonify({"ok": False, "error": "No draft — save first"})
    if not os.path.exists(MPV_BIN):
        return jsonify({"ok": False, "error": f"mpv not found at {MPV_BIN}"})
    subprocess.Popen(
        [MPV_BIN, f"--sub-file={DRAFT_PATH}", str(state["flac_path"])],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    return jsonify({"ok": True})

