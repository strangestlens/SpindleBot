});

// ────────────────────────────────────────────────────────────────────────────
// Lay Out Lyrics (import)
// ────────────────────────────────────────────────────────────────────────────
const importModal   = document.getElementById("import-modal");
const importTA      = document.getElementById("import-textarea");
const importWarning = document.getElementById("import-warning");
const importOkBtn   = document.getElementById("import-ok");
const importCancel  = document.getElementById("import-cancel");

function openImportModal() {
  importTA.value = "";
  const warn = importWarning;
  if (lyrics.length > 0) {
    warn.textContent = `⚠ This will replace ${lyrics.length} existing line${lyrics.length === 1 ? "" : "s"}.`;
    warn.style.display = "block";
  } else {
    warn.style.display = "none";
  }
  importModal.classList.add("open");
  setTimeout(() => importTA.focus(), 50);
}

function closeImportModal() {
  importModal.classList.remove("open");
}

function distributeLines(lines) {
  // Length-weighted distribution across track (or 5s/line fallback)
  const dur = duration > 0 ? duration : null;
  const weights = lines.map(l => Math.max(l.length, 1));
  const totalW  = weights.reduce((a, b) => a + b, 0);

  let result = [];
  if (dur) {
    // Leave a small tail so the last line isn't at the very end
    const usable = dur > 10 ? dur - 2 : dur * 0.95;
    let t = 0;
    for (let i = 0; i < lines.length; i++) {
      result.push({ time: Math.round(t * 100) / 100, text: lines[i] });
      t += (weights[i] / totalW) * usable;
    }
  } else {
    // No track loaded — 5s per line, length-weighted within that budget
    let t = 0;
    for (let i = 0; i < lines.length; i++) {
      result.push({ time: Math.round(t * 100) / 100, text: lines[i] });
      t += (weights[i] / totalW) * lines.length * 5;
    }
  }
  return result;
}

function doImport() {
  const raw = importTA.value;
  const lines = raw.split("\n").map(l => l.trim()).filter(l => l.length > 0);
  if (lines.length === 0) {
    importWarning.textContent = "No lines found — paste some lyrics first.";
    importWarning.style.display = "block";
    return;
  }
  pushUndo();
  lyrics = distributeLines(lines);
  activeIdx = -1;
  selectedMarkerIdx = -1;
  sortAndRender();
  updateDeleteBtn();
  closeImportModal();
  setStatus(`Laid out ${lines.length} lines ✓${duration > 0 ? "" : " (no track — times are placeholders)"}`);
}

document.getElementById("btn-audit-page").addEventListener("click",
  () => location.href = "/audit");

// ── AI Arrange ───────────────────────────────────────────────────────────────
const btnAI = document.getElementById("btn-ai");

btnAI.addEventListener("click", async () => {
  if (!fileLoaded) { setStatus("Load a track first", false); return; }
  const lines = lyrics.map(l => l.text).filter(t => t && t.trim());
  if (!lines.length) {
    setStatus("No lyric text — use Lay Out Lyrics first", false);
    return;
  }
  btnAI.disabled = true;
  btnAI.textContent = "🪄 Aligning…";
  const restore = () => { btnAI.disabled = false; btnAI.textContent = "🪄 AI Arrange"; };
  try {
    const r = await fetch("/ai-arrange", {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({ lines }),
    });
    const j = await r.json();
    if (!j.ok) throw new Error(j.error || "request failed");
  } catch (e) {
    restore();
    setStatus("AI arrange failed: " + e.message, false);
    return;
  }
  setStatus("AI listening to the track — can take a few minutes…");
  const poll = setInterval(async () => {
    let s;
    try { s = await (await fetch("/ai-arrange/status")).json(); }
    catch (e) { return; }  // transient — keep polling
    if (s.running) return;
    clearInterval(poll);
    restore();
    if (s.error || !s.result) {
      setStatus("AI arrange failed: " + (s.error || "no result"), false);
      return;
    }
    pushUndo();
    // Empty-text lines (deliberate markers) keep their manual times
    const keep = lyrics.filter(l => !(l.text && l.text.trim()));
    lyrics = s.result
      .map(x => ({ time: x.time, text: x.text, conf: x.confidence }))
      .concat(keep);
    activeIdx = -1;
    selectedMarkerIdx = -1;
    sortAndRender();
    updateDeleteBtn();
    const low = s.result.filter(x => x.confidence < 0.5).length;
    setStatus(`AI arranged ${s.result.length} lines` +
              (low ? ` — ${low} low-confidence (orange), review those` : "") + " ✓");
  }, 2000);
});

document.getElementById("btn-import").addEventListener("click", openImportModal);
importOkBtn.addEventListener("click", doImport);
importCancel.addEventListener("click", closeImportModal);
importModal.addEventListener("click", (e) => { if (e.target === importModal) closeImportModal(); });

importTA.addEventListener("keydown", (e) => {
  e.stopPropagation(); // don't let global shortcuts fire while typing
  if (e.key === "Escape") { e.preventDefault(); closeImportModal(); }
  // Ctrl+Enter = confirm
  if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) { e.preventDefault(); doImport(); }
});

// ────────────────────────────────────────────────────────────────────────────
// Markers
// ────────────────────────────────────────────────────────────────────────────
function renderMarkers() {
  markerLayer.innerHTML = "";
  if (!duration) return;
  lyrics.forEach((ln, i) => {
    const pct = ln.time / duration * 100;
    const el = document.createElement("div");
    el.className = "marker";
    if (ln.conf !== undefined && ln.conf < 0.5) el.classList.add("low-conf");
    el.style.left = pct + "%";
    el.dataset.idx = i;
    el.title = `[${fmtTime(ln.time)}] ${ln.text}` +
               (ln.conf !== undefined ? `  (AI conf ${ln.conf.toFixed(2)})` : "");

    const label = document.createElement("div");
    label.className = "marker-label";
    label.textContent = ln.text;
    el.appendChild(label);

    el.addEventListener("click", (e) => {
      e.stopPropagation();
      selectMarker(i, true);
    });

    makeDraggable(el, i);
    markerLayer.appendChild(el);
  });
}

function makeDraggable(el, idx) {
  let startX, startPct;

  el.addEventListener("mousedown", (e) => {
    e.preventDefault();
    selectMarker(idx, false);
    pushUndo();
    el.classList.add("dragging");
    startX = e.clientX;
    startPct = lyrics[idx].time / duration;

    const onMove = (e2) => {
      const rect2 = markerLayer.getBoundingClientRect();
      const dx = e2.clientX - startX;
      const newPct = Math.max(0, Math.min(1, startPct + dx / rect2.width));
      const newTime = newPct * duration;
      lyrics[idx].time = Math.round(newTime * 100) / 100;
      el.style.left = (newPct * 100) + "%";
      el.title = `[${fmtTime(lyrics[idx].time)}] ${lyrics[idx].text}`;
      const row = lyricsPanel.children[idx];
      if (row) row.querySelector(".lyric-time").textContent = fmtTime(lyrics[idx].time);
    };

    const onUp = () => {
      el.classList.remove("dragging");
      document.removeEventListener("mousemove", onMove);
      document.removeEventListener("mouseup", onUp);
      sortAndRender();
    };

    document.addEventListener("mousemove", onMove);
    document.addEventListener("mouseup", onUp);
  });
}

function sortAndRender() {
  lyrics.sort((a, b) => a.time - b.time);
  renderMarkers();
  renderLyrics();
}

function selectMarker(idx, seek=false) {
  selectedMarkerIdx = idx;
  if (seek && idx >= 0 && duration) ws.seekTo(lyrics[idx].time / duration);
  updateMarkerClasses();
  updateSelectedRow();
  updateDeleteBtn();
}

function nudgeSelected(delta) {
  if (selectedMarkerIdx < 0) return;
  pushUndo();
  const t = lyrics[selectedMarkerIdx].time + delta;
  lyrics[selectedMarkerIdx].time = Math.round(Math.max(0, Math.min(duration || 1e9, t)) * 100) / 100;
  const ref = lyrics[selectedMarkerIdx];
  sortAndRender();
  const reIdx = lyrics.indexOf(ref);
  selectedMarkerIdx = reIdx >= 0 ? reIdx : 0;
  updateMarkerClasses();
  updateSelectedRow();
  setStatus(`Nudged → ${fmtTime(lyrics[selectedMarkerIdx].time)}`);
}

function updateMarkerClasses() {
  const markers = markerLayer.querySelectorAll(".marker");
  markers.forEach((m, i) => {
    m.classList.toggle("active",   i === activeIdx);
    m.classList.toggle("selected", i === selectedMarkerIdx);
  });
}

function updateActiveMarker() { updateMarkerClasses(); }

function updateSelectedRow() {
  const rows = lyricsPanel.querySelectorAll(".lyric-row");
  rows.forEach((r, i) => r.classList.toggle("selected", i === selectedMarkerIdx));
  if (selectedMarkerIdx >= 0 && rows[selectedMarkerIdx]) {
    rows[selectedMarkerIdx].scrollIntoView({ block: "nearest", behavior: "smooth" });
  }
}

// ────────────────────────────────────────────────────────────────────────────
// Lyrics panel
// ────────────────────────────────────────────────────────────────────────────
function renderLyrics() {
  lyricsPanel.innerHTML = "";
  lyrics.forEach((ln, i) => {
    const row = document.createElement("div");
    row.className = "lyric-row";
    row.dataset.idx = i;

    const timeEl = document.createElement("span");
    timeEl.className = "lyric-time";
    timeEl.textContent = fmtTime(ln.time);

    const textEl = document.createElement("span");
    textEl.className = "lyric-text";
    textEl.textContent = ln.text || "";
    attachTextDblClick(textEl, i);

    const delBtn = document.createElement("button");
    delBtn.className = "lyric-del-btn";
    delBtn.textContent = "×";
    delBtn.title = "Delete line";
    delBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      selectMarker(i, false);
      deleteSelected();
    });

    row.appendChild(timeEl);
    row.appendChild(textEl);
    row.appendChild(delBtn);

    row.addEventListener("click", () => selectMarker(i, true));

    lyricsPanel.appendChild(row);
  });
}

function highlightActive() {
  const rows = lyricsPanel.querySelectorAll(".lyric-row");
  rows.forEach((r, i) => r.classList.toggle("active", i === activeIdx));
  if (activeIdx >= 0 && rows[activeIdx]) {
    rows[activeIdx].scrollIntoView({ block: "nearest", behavior: "smooth" });
  }
}

// ────────────────────────────────────────────────────────────────────────────
// Toolbar actions
// ────────────────────────────────────────────────────────────────────────────
document.getElementById("btn-add").addEventListener("click", addLine);
document.getElementById("btn-delete").addEventListener("click", deleteSelected);

document.getElementById("btn-save").addEventListener("click", async () => {
  const r = await fetch("/save", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify(lyrics),
  });
  const j = await r.json();
  setStatus(j.ok ? "Draft saved ✓" : "Save failed", j.ok);
});

document.getElementById("btn-preview").addEventListener("click", async () => {
  await fetch("/save", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify(lyrics),
  });
  const r = await fetch("/preview", { method: "POST" });
  const j = await r.json();
  setStatus(j.ok ? "mpv launched ✓" : (j.error || "Failed"), j.ok);
});

document.getElementById("btn-commit").addEventListener("click", async () => {
  const ok = await showConfirm("Overwrite the original .lrc file?", "Commit");
  if (!ok) return;
  await fetch("/save", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify(lyrics),
  });
  const r = await fetch("/commit", { method: "POST" });
  const j = await r.json();
  setStatus(j.ok ? "Committed to original file ✓" : (j.error || "Failed"), j.ok);
});

// ────────────────────────────────────────────────────────────────────────────
// Boot
// ────────────────────────────────────────────────────────────────────────────
(async () => {
  const resp = await fetch("/meta");
  const meta = await resp.json();

  if (meta.filename) {
    document.getElementById("file-label").textContent =
      meta.filename + (meta.lrc_new ? "  (new lyrics file)" : "");
    document.title = "LRC Editor — " + meta.filename;
    fileLoaded = true;

    const lr = await fetch("/lrc");
    lyrics = await lr.json();
    renderLyrics();
    initWaveSurfer();
  }
  // else: no file yet — just show the UI, Open button handles the rest
})();
</script>
</body>
</html>
"""

