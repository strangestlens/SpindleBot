@app.route("/open", methods=["POST"])
def open_file():
    try:
        result = subprocess.run(
            ["osascript", "-e",
             'POSIX path of (choose file with prompt "Select audio file"'
             ' of type {"flac", "mp3", "m4a", "aac", "wav", "ogg"})'],
            capture_output=True, text=True, timeout=300,
        )
        if result.returncode != 0:
            # User cancelled — osascript exits non-zero on cancel
            return jsonify({"ok": False, "cancelled": True})
        path = Path(result.stdout.strip()).resolve()
        if not path.exists():
            return jsonify({"ok": False, "error": "File not found"})
        state["flac_path"] = path
        state["lrc_path"]  = path.with_suffix(".lrc")
        _init_draft()
        lrc_note = "  (new .lrc)" if state["lrc_new"] else ""
        print(f"\n    ↳ Audio : {path}")
        print(f"      LRC   : {state['lrc_path']}{lrc_note}", flush=True)
        return jsonify({"ok": True, "lrc_new": state["lrc_new"]})
    except subprocess.TimeoutExpired:
        return jsonify({"ok": False, "cancelled": True})
    except Exception as e:
        return jsonify({"ok": False, "error": str(e)})

