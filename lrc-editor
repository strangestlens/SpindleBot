audit_job = {"thread": None, "result": None, "error": None}

def _run_audit(library_path, output_path):
    """Background thread: shell out to `lyric_timing audit --json`."""
    try:
        proc = subprocess.run(
            [sys.executable, "-m", "lyric_timing", "audit",
             str(library_path), "--json"],
            capture_output=True, text=True, cwd=PIPELINE_DIR, timeout=3600,
        )
        if proc.returncode != 0:
            tail = (proc.stderr or "").strip().splitlines()
            audit_job["error"] = tail[-1] if tail else f"exit {proc.returncode}"
            return
        Path(output_path).write_text(proc.stdout, encoding="utf-8")
        audit_job["result"] = json.loads(proc.stdout)
        _save_ui_state(audit_library=str(library_path),
                       audit_json=str(output_path))
    except Exception as e:
        audit_job["error"] = str(e)

# Formats a browser's decodeAudioData can play — deliberately narrower than
# spindlebot's AUDIO_EXTENSIONS (wv/ape/wma import fine via beets but would
# fail cryptically in the editor's WaveSurfer view).
AUDIO_SUFFIXES = (".flac", ".mp3", ".m4a", ".aac", ".wav", ".ogg", ".opus",
                  ".aif", ".aiff")

def _sibling_audio(lrc_path):
    for suffix in AUDIO_SUFFIXES:
        candidate = lrc_path.with_suffix(suffix)
        if candidate.exists():
            return candidate
    return None

def _run_ai_arrange(audio_path, lines, backend):
    """Background thread: shell out to `lyric_timing retime --json`."""
    tmp = None
    try:
        with tempfile.NamedTemporaryFile(
            "w", suffix=".txt", delete=False, encoding="utf-8"
        ) as fh:
            fh.write("\n".join(lines))
            tmp = fh.name
        # nice: keep the editor/browser responsive while torch churns.
        # MPS watermark: hard-cap torch's unified-memory appetite at half the
        # recommended working set — hitting the cap raises an OOM inside the
        # subprocess (its backend then retries on CPU) instead of dragging
        # the whole machine into swap.
        cmd = ["/usr/bin/nice", "-n", "15",
               str(AI_VENV_PY), "-m", "lyric_timing", "retime",
               str(audio_path), tmp, "--json", "--backend", backend]
        env = {**os.environ,
               "PYTORCH_MPS_HIGH_WATERMARK_RATIO": "0.5",
               "PYTORCH_MPS_LOW_WATERMARK_RATIO": "0.4"}
        proc = subprocess.run(
            cmd, capture_output=True, text=True, cwd=PIPELINE_DIR, env=env,
            timeout=1800,
        )
        if proc.returncode != 0:
            tail = (proc.stderr or "").strip().splitlines()
            ai_job["error"] = tail[-1] if tail else f"exit {proc.returncode}"
        else:
            ai_job["result"] = json.loads(proc.stdout)
    except Exception as e:
        ai_job["error"] = str(e)
    finally:
        if tmp:
            os.unlink(tmp)

