# ── LRC helpers ──────────────────────────────────────────────────────────────
_LRC_RE = re.compile(r"\[(\d+):(\d+\.\d+)\](.*)")

def parse_lrc(path: Path):
    lines = []
    if not path.exists():
        return lines
    for raw in path.read_text(encoding="utf-8").splitlines():
        m = _LRC_RE.match(raw.strip())
        if m:
            mins, secs, text = m.groups()
            t = int(mins) * 60 + float(secs)
            lines.append({"time": round(t, 2), "text": text.strip()})
    lines.sort(key=lambda x: x["time"])
    return lines

def format_lrc(lines):
    out = []
    for ln in sorted(lines, key=lambda x: x["time"]):
        t = ln["time"]
        mins = int(t) // 60
        secs = t - mins * 60
        out.append(f"[{mins:02d}:{secs:05.2f}]{ln['text']}")
    return "\n".join(out) + "\n"

# ── Free port ────────────────────────────────────────────────────────────────
