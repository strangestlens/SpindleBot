@app.route("/audit/run", methods=["POST"])
def audit_run():
    if audit_job["thread"] is not None and audit_job["thread"].is_alive():
        return jsonify({"ok": False, "error": "audit already running"}), 409
    data = request.get_json(force=True)
    library = Path(data.get("library", "")).expanduser()
    output = Path(data.get("output", "")).expanduser()
    if not library.is_dir():
        return jsonify({"ok": False, "error": f"not a directory: {library}"})
    if not output.parent.is_dir():
        return jsonify({"ok": False, "error": f"no such folder: {output.parent}"})
    audit_job["result"] = None
    audit_job["error"] = None
    t = threading.Thread(target=_run_audit, args=(library, output), daemon=True)
    audit_job["thread"] = t
    t.start()
    return jsonify({"ok": True})

