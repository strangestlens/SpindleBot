def _save_ui_state(**updates):
    merged = _load_ui_state()
    merged.update(updates)
    UI_STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    UI_STATE_PATH.write_text(json.dumps(merged, indent=2), encoding="utf-8")

