<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.strangestlens.music-sync-rugged</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
    <string>-a</string>
    <string>/Users/danielwilliams/Applications/MusicSync.app</string>
  </array>

  <!-- Fire when DwRugged appears -->
  <key>WatchPaths</key>
  <array>
    <string>/Volumes/DwRugged</string>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/danielwilliams/.config/beets/rugged-sync-stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/danielwilliams/.config/beets/rugged-sync-stderr.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
