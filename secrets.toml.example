# SpindleBot secrets
# Copy to ~/.config/spindlebot/secrets.toml and fill in real values.
# This file is NEVER committed to the repo.
#
# All values here can also be set as environment variables, which take
# precedence over this file:
#   SPINDLEBOT_TELEGRAM_TOKEN
#   SPINDLEBOT_TELEGRAM_CHAT_ID
#   SPINDLEBOT_GENIUS_KEY

[telegram]
bot_token = ""   # from @BotFather
chat_id   = ""   # your personal chat ID

[genius]
api_key = ""     # from genius.com/api-clients
